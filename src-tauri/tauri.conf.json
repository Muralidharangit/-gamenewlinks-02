{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "winbet-smart-pc",
  "version": "1.0.0",
  "identifier": "com.winbet.smartpc",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WinBet Smart PC",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "shortDescription": "WinBet Smart PC Gaming Terminal",
    "longDescription": "WinBet Smart PC Dedicated Gaming Terminal and Kiosk Application",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libsoup-3.0-0 | libsoup2.4-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
